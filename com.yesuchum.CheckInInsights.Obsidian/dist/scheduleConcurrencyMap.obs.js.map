<template>
    <Panel title="Check-in Timeline" type="block">
        <template #headerActions>
            <div class="cci-header-actions">
                <DatePicker v-model="date" />
                <button type="button"
                        class="btn btn-grid-action"
                        title="Jump to next Sunday"
                        @click="onNextSunday">
                    <i class="ti ti-calendar-share"></i>
                </button>
                <button type="button"
                        class="btn btn-grid-action"
                        :class="{ active: isOverlapFlagShown }"
                        title="Show possible double-bookings."
                        @click="onToggleOverlapFlags">
                    <i class="ti ti-alert-triangle"></i>
                </button>
                <button type="button"
                        class="btn btn-grid-action"
                        :class="{ active: hasActiveFilters }"
                        title="Adjust list settings."
                        :disabled="isLoading"
                        @click="isFilterModalOpen = true">
                    <i class="ti ti-adjustments-horizontal"></i>
                </button>
            </div>
        </template>

        <NotificationBox v-if="errorMessage" alertType="danger" :dismissible="true" @dismiss="errorMessage = ''">
            {{ errorMessage }}
        </NotificationBox>

        <NotificationBox v-if="hasLoaded && !hasWindows" alertType="info">
            No check-in schedule windows were found for this date and filter.
        </NotificationBox>

        <WindowDetailPanel v-model="isDetailPanelOpen"
                           :window="selectedWindow"
                           :allWindows="allWindows"
                           @select="onSelectWindow" />

        <div v-if="hasWindows">
            <div class="cci-legend">
                <span class="cci-legend-item"><span class="cci-swatch cci-swatch-legacy"></span> Legacy check-in</span>
                <span class="cci-legend-item"><span class="cci-swatch cci-swatch-nextgen"></span> Next-Gen check-in</span>
                <span v-if="isOverlapFlagShown" class="cci-legend-item"><span class="cci-swatch cci-swatch-double"></span> Possible double-booking</span>
            </div>

            <div class="cci-timeline" :style="{ '--cci-hours': hourSpan }">
                <div class="cci-hours-row">
                    <div class="cci-row-label"></div>
                    <div class="cci-row-track">
                        <span v-for="hour in hourTicks"
                              :key="hour.label"
                              class="cci-hour-tick"
                              :style="{ left: hour.left }">
                            {{ hour.label }}
                        </span>
                    </div>
                </div>

                <template v-for="area in areaGroups" :key="area.areaPath">
                    <div class="cci-area-header">
                        {{ area.areaPath }}
                        <span class="text-muted cci-area-template">{{ area.templateName }}</span>
                    </div>

                    <div v-for="row in area.rows" :key="row.key" class="cci-location-row">
                        <div class="cci-row-label" :title="row.locationName">{{ row.locationName }}</div>
                        <div class="cci-row-track" :style="{ height: (row.laneCount * 30) + 'px' }">
                            <div v-if="nowLinePct !== null" class="cci-now-line" :style="{ left: nowLinePct }"></div>
                            <div v-for="block in row.blocks"
                                 :key="block.key"
                                 class="cci-window"
                                 :class="{
                                     'cci-window-nextgen': block.window.isNextGen,
                                     'cci-window-double': isOverlapFlagShown && block.window.isDoubleBooked
                                 }"
                                 :style="{ left: block.left, width: block.width, top: (block.lane * 30) + 'px' }"
                                 :title="blockTooltip(block.window)"
                                 @click="onSelectWindow(block.window)">
                                {{ block.window.groupName }}
                                <span v-if="block.window.attendanceCount != null" class="cci-count-chip">{{ block.window.attendanceCount }}</span>
                            </div>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <FiltersModal v-model="isFilterModalOpen"
                      :sections="filterSections"
                      v-model:selections="filterSelections" />
    </Panel>
</template>

<style scoped>
.cci-header-actions {
    display: flex;
    align-items: center;
    gap: 4px;
}

/* The DatePicker is a form-group; strip its stacking so it sits inline in the header. */
.cci-header-actions :deep(.form-group) {
    margin-bottom: 0;
}

.cci-header-actions :deep(.input-group) {
    width: 160px;
}

.cci-legend {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin: 8px 0 12px;
}

.cci-legend-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
}

.cci-swatch {
    display: inline-block;
    width: 14px;
    height: 14px;
    border-radius: 3px;
}

.cci-swatch-legacy {
    background: #6b8fc9;
}

.cci-swatch-nextgen {
    background: #5cb85c;
}

.cci-swatch-double {
    background: #fff;
    border: 2px solid #d9534f;
}

.cci-timeline {
    border: 1px solid var(--color-interface-soft, #dfe0e1);
    border-radius: 4px;
    overflow: hidden;
}

.cci-hours-row,
.cci-location-row {
    display: flex;
    border-bottom: 1px solid var(--color-interface-soft, #eee);
}

.cci-row-label {
    flex: 0 0 180px;
    padding: 4px 8px;
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    border-right: 1px solid var(--color-interface-soft, #eee);
}

.cci-row-track {
    position: relative;
    flex: 1 1 auto;
    min-height: 30px;
    background-image: repeating-linear-gradient(to right, transparent, transparent calc(100% / var(--cci-hours) - 1px), rgba(0, 0, 0, 0.06) calc(100% / var(--cci-hours) - 1px), rgba(0, 0, 0, 0.06) calc(100% / var(--cci-hours)));
}

.cci-hours-row .cci-row-track {
    height: 24px;
    background-image: none;
}

.cci-hour-tick {
    position: absolute;
    top: 2px;
    transform: translateX(-50%);
    font-size: 11px;
    color: #888;
}

.cci-area-header {
    padding: 4px 8px;
    font-weight: 600;
    font-size: 13px;
    background: var(--color-interface-softer, #f5f5f5);
    border-bottom: 1px solid var(--color-interface-soft, #eee);
}

.cci-area-template {
    font-weight: 400;
    font-size: 11px;
    margin-left: 8px;
}

.cci-window {
    position: absolute;
    height: 26px;
    margin-top: 2px;
    padding: 2px 6px;
    border-radius: 3px;
    background: #6b8fc9;
    color: #fff;
    font-size: 11px;
    line-height: 20px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.cci-window-nextgen {
    background: #5cb85c;
}

.cci-window-double {
    box-shadow: inset 0 0 0 2px #d9534f;
}

.cci-window {
    cursor: pointer;
}

.cci-count-chip {
    display: inline-block;
    margin-left: 4px;
    padding: 0 5px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.3);
    font-weight: 700;
}

.cci-now-line {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #d9534f;
    opacity: 0.6;
    pointer-events: none;
    z-index: 1;
}

</style>

<script setup lang="ts">
    import { computed, onUnmounted, ref, watch } from "vue";
    import DatePicker from "@Obsidian/Controls/datePicker.obs";
    import NotificationBox from "@Obsidian/Controls/notificationBox.obs";
    import Panel from "@Obsidian/Controls/panel.obs";
    import { useConfigurationValues, useInvokeBlockAction, usePersonPreferences } from "@Obsidian/Utility/block";
    import FiltersModal, { FilterSection } from "./CheckInInsights/filtersModal.partial.obs";
    import WindowDetailPanel from "./CheckInInsights/windowDetailPanel.partial.obs";
    import type { CheckInInsightsInitBag, ConcurrencyResultBag, ScheduleWindowBag } from "./CheckInInsights/types.partial";

    const box = useConfigurationValues<CheckInInsightsInitBag>();
    const invokeBlockAction = useInvokeBlockAction();

    const date = ref<string>(box.defaultDate ?? "");
    const isLoading = ref(false);
    const hasLoaded = ref(false);
    const errorMessage = ref("");
    const result = ref<ConcurrencyResultBag | null>(null);
    const selectedWindow = ref<ScheduleWindowBag | null>(null);
    const isDetailPanelOpen = ref(false);

    function onSelectWindow(window: ScheduleWindowBag): void {
        selectedWindow.value = window;
        isDetailPanelOpen.value = true;
    }

    // #region Filters

    const NO_CAMPUS = "No campus";

    const isFilterModalOpen = ref(false);

    const preferences = usePersonPreferences().blockPreferences;
    const filterKeys = ["campus", "template", "area"];

    /** Restores saved selections (JSON arrays) from person preferences. */
    function loadSavedSelections(): Record<string, string[]> {
        const selections: Record<string, string[]> = {};
        for (const key of filterKeys) {
            try {
                const parsed = JSON.parse(preferences.getValue(`filter-${key}`) || "[]");
                selections[key] = Array.isArray(parsed) ? parsed : [];
            }
            catch {
                selections[key] = [];
            }
        }
        return selections;
    }

    /** Applied modal selections per dimension. Empty array = all. Persisted per person. */
    const filterSelections = ref<Record<string, string[]>>(loadSavedSelections());

    watch(filterSelections, async () => {
        for (const key of filterKeys) {
            preferences.setValue(`filter-${key}`, JSON.stringify(filterSelections.value[key] ?? []));
        }
        await preferences.save();
    });

    const allWindows = computed<ScheduleWindowBag[]>(() => result.value?.windows ?? []);

    function distinct(values: (string | null | undefined)[], fallback: string): string[] {
        return [...new Set(values.map(v => v ?? fallback))].sort();
    }

    const filterSections = computed<FilterSection[]>(() => [
        { key: "campus", label: "Campuses", options: distinct(allWindows.value.map(w => w.campusName), NO_CAMPUS) },
        { key: "template", label: "Configurations", options: distinct(allWindows.value.map(w => w.templateName), "") },
        { key: "area", label: "Group Types", options: distinct(allWindows.value.map(w => w.areaPath), "") }
    ]);

    function passes(selection: string[], value: string): boolean {
        return selection.length === 0 || selection.includes(value);
    }

    const windows = computed<ScheduleWindowBag[]>(() => {
        const f = filterSelections.value;
        return allWindows.value.filter(w =>
            passes(f.campus ?? [], w.campusName ?? NO_CAMPUS)
            && passes(f.template ?? [], w.templateName ?? "")
            && passes(f.area ?? [], w.areaPath ?? ""));
    });

    const hasActiveFilters = computed<boolean>(() => {
        return Object.values(filterSelections.value).some(s => s.length > 0);
    });

    /** Whether possible double-bookings are highlighted. Persisted per person. */
    const isOverlapFlagShown = ref<boolean>(preferences.getValue("show-overlap-flags") !== "false");

    async function onToggleOverlapFlags(): Promise<void> {
        isOverlapFlagShown.value = !isOverlapFlagShown.value;
        preferences.setValue("show-overlap-flags", String(isOverlapFlagShown.value));
        await preferences.save();
    }

    // #endregion

    const hasWindows = computed(() => windows.value.length > 0);

    // #region Timeline layout

    /** Fractional hour-of-day for an ISO date string. */
    function hourOf(iso: string | null | undefined): number {
        if (!iso) {
            return 0;
        }
        const d = new Date(iso);
        return d.getHours() + d.getMinutes() / 60;
    }

    /**
     * Visible time range: the data's check-in windows padded to the whole hour
     * on either side, falling back to 6am-10pm when there is nothing to show.
     */
    const timeRange = computed<{ min: number, max: number }>(() => {
        let min = 24;
        let max = 0;
        for (const w of windows.value) {
            min = Math.min(min, hourOf(w.checkInStart));
            max = Math.max(max, hourOf(w.checkInEnd));
        }
        if (min >= max) {
            return { min: 6, max: 22 };
        }
        return { min: Math.max(0, Math.floor(min) - 1), max: Math.min(24, Math.ceil(max) + 1) };
    });

    function pct(hour: number): string {
        const { min, max } = timeRange.value;
        return (((hour - min) / (max - min)) * 100).toFixed(2) + "%";
    }

    const hourSpan = computed(() => timeRange.value.max - timeRange.value.min);

    /** Left offset of the current-time line, or null when not viewing today. */
    const nowLinePct = computed<string | null>(() => {
        const now = new Date();
        const selected = date.value ? new Date(date.value) : now;
        const isToday = selected.getFullYear() === now.getFullYear()
            && selected.getMonth() === now.getMonth()
            && selected.getDate() === now.getDate();

        if (!isToday) {
            return null;
        }

        const hour = now.getHours() + now.getMinutes() / 60;
        if (hour < timeRange.value.min || hour > timeRange.value.max) {
            return null;
        }

        return pct(hour);
    });

    const hourTicks = computed(() => {
        const ticks: { label: string, left: string }[] = [];
        for (let h = timeRange.value.min; h <= timeRange.value.max; h++) {
            const label = h === 0 ? "12a" : h < 12 ? `${h}a` : h === 12 ? "12p" : `${h - 12}p`;
            ticks.push({ label, left: pct(h) });
        }
        return ticks;
    });

    interface TimelineBlock {
        key: string;
        window: ScheduleWindowBag;
        left: string;
        width: string;
        lane: number;
    }

    interface LocationRow {
        key: string;
        locationName: string;
        laneCount: number;
        blocks: TimelineBlock[];
    }

    interface AreaGroup {
        areaPath: string;
        templateName: string;
        rows: LocationRow[];
    }

    /**
     * Groups windows by area, then by location. Within a location row, windows
     * are packed into lanes so overlapping windows stack instead of covering
     * each other (that is exactly the double-booked case).
     */
    const areaGroups = computed<AreaGroup[]>(() => {
        const areas = new Map<string, AreaGroup>();

        for (const w of windows.value) {
            const areaKey = `${w.templateName}|${w.areaPath}`;
            let area = areas.get(areaKey);
            if (!area) {
                area = { areaPath: w.areaPath ?? "", templateName: w.templateName ?? "", rows: [] };
                areas.set(areaKey, area);
            }

            const locKey = w.locationIdKey ?? w.locationName ?? "?";
            let row = area.rows.find(r => r.key === `${areaKey}|${locKey}`);
            if (!row) {
                row = { key: `${areaKey}|${locKey}`, locationName: w.locationName ?? "Unknown location", laneCount: 1, blocks: [] };
                area.rows.push(row);
            }

            const startHour = hourOf(w.checkInStart);
            const endHour = Math.max(hourOf(w.checkInEnd), startHour + 0.25);

            // First lane whose last block ends before this one starts.
            let lane = 0;
            const laneEnds: number[] = [];
            for (const b of row.blocks) {
                laneEnds[b.lane] = Math.max(laneEnds[b.lane] ?? 0, hourOf(b.window.checkInEnd));
            }
            while ((laneEnds[lane] ?? 0) > startHour) {
                lane++;
            }

            row.blocks.push({
                key: `${row.key}|${w.groupIdKey}|${w.scheduleIdKey}|${w.checkInStart}`,
                window: w,
                left: pct(startHour),
                width: (((endHour - startHour) / (timeRange.value.max - timeRange.value.min)) * 100).toFixed(2) + "%",
                lane
            });
            row.laneCount = Math.max(row.laneCount, lane + 1);
        }

        return [...areas.values()];
    });

    // #endregion

    function formatTime(iso: string | null | undefined): string {
        if (!iso) {
            return "?";
        }
        return new Date(iso).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
    }

    function blockTooltip(w: ScheduleWindowBag): string {
        const lines = [
            `${w.groupName} @ ${w.locationName}`,
            `Campus: ${w.campusName ?? "Unknown"}`,
            `Schedule: ${w.scheduleLabel}`,
            `Check-in: ${formatTime(w.checkInStart)} - ${formatTime(w.checkInEnd)}`,
            `Event: ${formatTime(w.start)} - ${formatTime(w.end)}`
        ];
        if (w.capacity != null) {
            lines.push(`Capacity: ${w.capacity}`);
        }
        if (w.firmRoomThreshold != null) {
            lines.push(`Firm threshold: ${w.firmRoomThreshold}`);
        }
        if (w.isDoubleBooked) {
            lines.push("POSSIBLE DOUBLE-BOOKING: another group in this same check-in configuration has an overlapping event in this room on a different schedule.");
        }
        return lines.join("\n");
    }

    /** Jumps the date to the next upcoming Sunday (stays put if already on a Sunday). */
    function onNextSunday(): void {
        const base = date.value ? new Date(date.value) : new Date();
        const target = new Date(base);
        target.setDate(base.getDate() + ((7 - base.getDay()) % 7));
        date.value = `${target.getFullYear()}-${String(target.getMonth() + 1).padStart(2, "0")}-${String(target.getDate()).padStart(2, "0")}`;
    }

    async function load(): Promise<void> {
        errorMessage.value = "";
        isLoading.value = true;
        try {
            // No campus in the request = all campuses; scoping happens client-side.
            const response = await invokeBlockAction<ConcurrencyResultBag>("GetConcurrency", {
                filter: { date: date.value }
            });

            if (response.isSuccess && response.data) {
                result.value = response.data;
                hasLoaded.value = true;
            }
            else {
                errorMessage.value = response.errorMessage ?? "Unable to load timeline data.";
            }
        }
        finally {
            isLoading.value = false;
        }
    }

    // #region Auto-refresh

    let refreshTimer: ReturnType<typeof setInterval> | null = null;

    function isViewingToday(): boolean {
        if (!date.value) {
            return true;
        }
        const now = new Date();
        const selected = new Date(date.value);
        return selected.getFullYear() === now.getFullYear()
            && selected.getMonth() === now.getMonth()
            && selected.getDate() === now.getDate();
    }

    /**
     * When viewing today, reload every minute so check-in counts and the now
     * line stay live on a wall screen. Any other date is static data.
     */
    function setupAutoRefresh(): void {
        if (refreshTimer !== null) {
            clearInterval(refreshTimer);
            refreshTimer = null;
        }
        if (isViewingToday()) {
            refreshTimer = setInterval(load, 60000);
        }
    }

    onUnmounted(() => {
        if (refreshTimer !== null) {
            clearInterval(refreshTimer);
        }
    });

    // #endregion

    watch(date, () => {
        selectedWindow.value = null;
        isDetailPanelOpen.value = false;
        load();
        setupAutoRefresh();
    });

    load();
    setupAutoRefresh();
</script>
