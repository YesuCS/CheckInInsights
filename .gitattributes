# Lock LF as the canonical line ending for the repo. Avoids spurious
# "every file modified" diffs when contributors on different OSes (or with
# different `core.autocrlf` settings) edit the same file. Binary files
# pass through untouched.
* text=auto eol=lf

# Binary files — never normalize.
*.dll  binary
*.pdb  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.plugin binary
